{
  "name": "General Knowledge Graph Perspective",
  "description": "Domain-agnostic exploration of entities and relationships",
  "categories": [
    {
      "name": "Entity Clusters",
      "query": "MATCH p=(e1)-[r]-(e2) WHERE id(e1) < id(e2) RETURN p LIMIT 500",
      "description": "Explore entity clusters and communities"
    },
    {
      "name": "Central Entities",
      "query": "MATCH (n) WITH n, size((n)--()) as degree WHERE degree > 5 MATCH p=(n)-[r]-(m) RETURN p",
      "description": "Find highly connected central entities"
    },
    {
      "name": "Semantic Similarity",
      "query": "MATCH p=(e1)-[:SIMILAR_TO|RELATES_TO|SAME_AS]-(e2) RETURN p",
      "description": "Explore semantically similar entities"
    },
    {
      "name": "Hierarchical Structure",
      "query": "MATCH p=(parent)-[:CONTAINS|PARENT_OF|HAS_CHILD*..3]-(child) RETURN p",
      "description": "View hierarchical relationships"
    },
    {
      "name": "Temporal Sequences",
      "query": "MATCH p=(e1)-[:BEFORE|AFTER|FOLLOWS|PRECEDES*..5]-(e2) RETURN p",
      "description": "Analyze temporal sequences and timelines"
    },
    {
      "name": "Cross-References",
      "query": "MATCH p=(doc1:DOCUMENT)-[:REFERENCES|CITES|MENTIONS]-(doc2:DOCUMENT) RETURN p",
      "description": "Explore document cross-references"
    },
    {
      "name": "Entity Co-occurrence",
      "query": "MATCH (e1)-[:APPEARS_WITH|CO_OCCURS]-(e2) WITH e1, e2, count(*) as weight WHERE weight > 2 MATCH p=(e1)-[r]-(e2) RETURN p",
      "description": "Find frequently co-occurring entities"
    }
  ],
  "node_styles": {
    "Entity": {
      "color": "#95A5A6",
      "size": "degree",
      "icon": "lens"
    }
  },
  "relationship_styles": {
    "default": {
      "color": "#7F8C8D",
      "thickness": "weight"
    }
  },
  "search_phrases": [
    {
      "phrase": "Find connections between $entity1 and $entity2",
      "query": "MATCH p=shortestPath((e1 {text: $entity1})-[*..5]-(e2 {text: $entity2})) RETURN p"
    },
    {
      "phrase": "Show everything about $entity",
      "query": "MATCH p=(e {text: $entity})-[r]-() RETURN p"
    },
    {
      "phrase": "Find similar to $entity",
      "query": "MATCH (e1 {text: $entity})-[:SIMILAR_TO|RELATES_TO*..2]-(e2) RETURN e2"
    }
  ]
}