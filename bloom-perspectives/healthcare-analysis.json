{
  "name": "Healthcare Analysis Perspective",
  "description": "Analyze medical entities, treatments, and patient relationships",
  "categories": [
    {
      "name": "Treatment Pathways",
      "query": "MATCH p=(patient:PATIENT)-[:DIAGNOSED_WITH]->(disease:DISEASE)<-[:TREATS]-(treatment:TREATMENT) RETURN p",
      "description": "Explore treatment options for diagnosed conditions"
    },
    {
      "name": "Drug Interactions",
      "query": "MATCH p=(drug1:DRUG)-[:INTERACTS_WITH]-(drug2:DRUG) RETURN p",
      "description": "Identify potential drug interactions"
    },
    {
      "name": "Clinical Trials",
      "query": "MATCH p=(trial:CLINICAL_TRIAL)-[:TESTS]->(drug:DRUG)-[:TARGETS]->(disease:DISEASE) RETURN p",
      "description": "View clinical trial relationships"
    },
    {
      "name": "Provider Networks",
      "query": "MATCH p=(provider:HEALTHCARE_PROVIDER)-[:AFFILIATED_WITH|REFERS_TO*..3]-(org:HEALTHCARE_ORGANIZATION) RETURN p",
      "description": "Map healthcare provider networks"
    },
    {
      "name": "Symptom Clusters",
      "query": "MATCH p=(symptom1:SYMPTOM)-[:CO_OCCURS_WITH]-(symptom2:SYMPTOM)-[:INDICATES]->(disease:DISEASE) RETURN p",
      "description": "Analyze symptom patterns and disease indicators"
    }
  ],
  "node_styles": {
    "PATIENT": {
      "color": "#3498DB",
      "size": "medium",
      "icon": "person"
    },
    "DISEASE": {
      "color": "#E74C3C",
      "size": "prevalence",
      "icon": "coronavirus"
    },
    "DRUG": {
      "color": "#2ECC71",
      "size": "medium",
      "icon": "medication"
    },
    "TREATMENT": {
      "color": "#F39C12",
      "size": "effectiveness",
      "icon": "healing"
    },
    "SYMPTOM": {
      "color": "#9B59B6",
      "size": "frequency",
      "icon": "sick"
    }
  }
}