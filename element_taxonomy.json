{
  "version": "1.0.0",
  "description": "Universal Document Model - Element Category Taxonomy",
  "categories": {
    "container": {
      "description": "Top-level organizational units that group other elements",
      "element_types": [
        "root",
        "page",
        "slide",
        "sheet",
        "workbook",
        "body",
        "presentation_body",
        "section",
        "div",
        "article"
      ]
    },
    "content": {
      "description": "Textual content blocks that carry primary information",
      "element_types": [
        "paragraph",
        "header",
        "text_box",
        "blockquote",
        "code_block",
        "line",
        "substring"
      ]
    },
    "structure": {
      "description": "Organizational elements that provide document structure",
      "element_types": [
        "table",
        "table_row",
        "table_header_row",
        "list",
        "list_item",
        "shape_group",
        "merged_cells",
        "data_tables",
        "data_table"
      ]
    },
    "component": {
      "description": "Leaf components within structural elements",
      "element_types": [
        "table_cell",
        "table_header",
        "merged_cell",
        "shape",
        "json_field",
        "json_item",
        "json_object",
        "json_array",
        "xml_text",
        "xml_element",
        "xml_list",
        "xml_object",
        "range"
      ]
    },
    "metadata": {
      "description": "Supplementary information and annotations",
      "element_types": [
        "comment",
        "comments",
        "comments_container",
        "slide_notes",
        "page_header",
        "page_footer",
        "headers",
        "footers",
        "slide_masters",
        "slide_templates",
        "slide_layout",
        "slide_master",
        "chart",
        "image"
      ]
    }
  },
  "default_category": "component",
  "relationships": {
    "description": "Relationship types in the Universal Document Model",
    "types": [
      "contains",
      "contained_by",
      "references",
      "referenced_by",
      "next",
      "previous",
      "links_to"
    ]
  }
}
